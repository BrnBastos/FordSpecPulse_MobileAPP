{
  "expo": {
    "name": "Ford SpecPulse",
    "slug": "FordSpecPulse_Mobile",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/specpulse-mark.png",
    "scheme": "fordspecpulsemobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001F54",
        "foregroundImage": "./assets/images/specpulse-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brnbastos.fordspecpulse",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/specpulse-mark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001F54",
          "image": "./assets/images/specpulse-mark.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "bbastos",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "429a726f-9a7d-41d5-83f0-04218a0113c2"
      }
    }
  }
}
